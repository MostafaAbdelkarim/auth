# Local development: copy to apps/api/.env  (cp .env.example .env)
NODE_ENV=development
PORT=3000
# The docker compose MongoDB requires auth: use the app user and MONGO_APP_PASSWORD from the root .env
MONGO_URI=mongodb://app:CHANGE_ME_MONGO_APP_PASSWORD@localhost:27017/easygenerator-auth?authSource=easygenerator-auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=5
REFRESH_REUSE_GRACE_SECONDS=10
# The web app reaches the API through the Vite proxy (same origin), so CORS can stay empty.
CORS_ORIGINS=
TRUST_PROXY=false
SWAGGER_ENABLED=true
# Optional in development; required with Swagger in production (`make setup` fills them in)
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
COOKIE_SECURE=false
# Only for a production-mode demo over http; never in a real deployment
ALLOW_INSECURE_COOKIES=false
LOG_LEVEL=info
# Optional: also write logs to LOG_DIR/YYYY/MM/YYYY-MM-DD.log (UTC). Empty = stdout only.
LOG_DIR=
