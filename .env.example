# Used by docker compose. `make setup` creates .env from this file and fills in every empty
# secret for you. To do it by hand, generate each value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the real .env.
JWT_ACCESS_SECRET=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# Login for the API docs at /api/docs (HTTP Basic auth)
SWAGGER_USERNAME=docs
SWAGGER_PASSWORD=

# Optional overrides
# SWAGGER_ENABLED=false    # hide the API docs entirely
# LOG_LEVEL=debug          # step-by-step request traces
